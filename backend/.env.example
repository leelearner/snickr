# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored.

DATABASE_URL=postgresql://jessica@localhost:5432/snickr

# Random string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Frontend dev origin(s). Used by CORS middleware so the React dev server
# can call the API with credentials. Comma-separate multiple origins.
# If the frontend uses Vite's server.proxy for /api, this is unused.
FRONTEND_ORIGIN=http://localhost:5173
